# MySQL（给 docker compose 用）
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# 宿主机端口：本机已有 mysqld 占 3306 时改用 3307（容器内仍是 3306）
MYSQL_PORT=

# Spring 数据源（给应用用；本地通常与上面业务账号一致）
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=

# RocketMQ
ROCKETMQ_IMAGE_TAG=5.1.4
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_HA_PORT=10912
ROCKETMQ_BROKER_VIP_PORT=10909
ROCKETMQ_NAMESRV_JAVA_OPT=-Xms1g -Xmx1g
ROCKETMQ_BROKER_JAVA_OPT=-Xms2g -Xmx2g
ROCKETMQ_BROKER_IP=
ROCKETMQ_NAMESRV_BIND=
ROCKETMQ_BROKER_BIND=

