# MySQL（给 docker compose 用）
MYSQL_DATABASE=cms
MYSQL_USER=cms
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
# 宿主机映射端口；若本机 3306 已被占用可改为 3307
MYSQL_PORT=3307

# Spring 数据源（给应用用；本地通常与上面业务账号一致）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=cms
DB_USERNAME=cms
DB_PASSWORD=change_me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# RocketMQ
ROCKETMQ_IMAGE_TAG=5.1.4
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_HA_PORT=10912
ROCKETMQ_BROKER_VIP_PORT=10909
ROCKETMQ_NAMESRV_JAVA_OPT=-Xms512m -Xmx512m
ROCKETMQ_BROKER_JAVA_OPT=-Xms512m -Xmx512m

# OSS
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# XXL-JOB
XXL_JOB_ADMIN_IMAGE_TAG=2.4.2
XXL_JOB_ADMIN_PORT=8088
XXL_JOB_ADMIN_ADDRESS=http://127.0.0.1:8088/xxl-job-admin
XXL_JOB_EXECUTOR_PORT=9999
XXL_JOB_ACCESS_TOKEN=
XXL_JOB_LOG_PATH=./logs/xxl-job
