# MySQL（给 docker compose 用）
MYSQL_DATABASE=cms
MYSQL_USER=cms
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
# 宿主机映射端口；若本机 3306 已被占用可改为 3307
MYSQL_PORT=3307

# Spring 数据源（给应用用；本地通常与上面业务账号一致）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=cms
DB_USERNAME=cms
DB_PASSWORD=change_me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
