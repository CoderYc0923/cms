[Unit]
Description=CMS Backend (Spring Boot)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cms-back
EnvironmentFile=/opt/cms-back/.env

# 2G 轻量机建议堆；jar 名按实际上传文件修改
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /opt/cms-back/cms-back-admin.jar --spring.profiles.active=prod

SuccessExitStatus=143
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/cms-back/logs/app.log
StandardError=append:/opt/cms-back/logs/app.log

[Install]
WantedBy=multi-user.target
