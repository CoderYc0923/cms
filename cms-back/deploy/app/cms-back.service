[Unit]
Description=CMS Backend (Spring Boot)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cms-back
EnvironmentFile=/opt/cms-back/.env

# 2G 同机（MySQL/Redis/MQ）建议 128/256；内存充裕可改为 256/512
ExecStart=/usr/bin/java -Xms128m -Xmx256m -jar /opt/cms-back/cms-back-admin.jar --spring.profiles.active=prod

SuccessExitStatus=143
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/cms-back/logs/app.log
StandardError=append:/opt/cms-back/logs/app.log

[Install]
WantedBy=multi-user.target
