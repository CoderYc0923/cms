# 中间件 compose 专用（复制为 .env 后修改密码）
# 应用连接信息见下方「应用 .env 参考」——复制到你本机/服务器上的 cms-back/.env

# ---------- MySQL（compose 建库）----------
MYSQL_DATABASE=cms
MYSQL_USER=cms
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PORT=3307

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- RocketMQ（2G 演示机务必用小堆）----------
ROCKETMQ_IMAGE_TAG=5.3.1
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_HA_PORT=10912
ROCKETMQ_BROKER_VIP_PORT=10909
ROCKETMQ_NAMESRV_JAVA_OPT=-Xms128m -Xmx256m
ROCKETMQ_BROKER_JAVA_OPT=-Xms128m -Xmx256m

# ---------- XXL-Job Admin ----------
XXL_JOB_ADMIN_IMAGE_TAG=2.4.2
XXL_JOB_ADMIN_PORT=8088

# ---------- 应用 .env 参考（写入 cms-back/.env，非 compose 读取）----------
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_NAME=cms
# DB_USERNAME=cms
# DB_PASSWORD=与 MYSQL_PASSWORD 一致
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# ROCKETMQ_NAME_SERVER=127.0.0.1:9876
# XXL_JOB_ADMIN_ADDRESSES=http://127.0.0.1:8088/xxl-job-admin
